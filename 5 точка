template<class T>

class MatrixSet {

private:

	T** arr;

	int size;

	int capacity;

public:

	//////////////////////////////////////////////////

	MatrixSet(int cap = 10) {

		capacity = cap;

		size = 0;

		arr = new T * [capacity];
	}

	//////////////////////////////////////////////////

	~MatrixSet() {

		delete[] arr;
	}

	//////////////////////////////////////////////////

	void add(T* obj) {

		if (size < capacity) {

			arr[size] = obj;

			size++;
		}
	}

	//////////////////////////////////////////////////

	void showAll() {

		cout << "\nВсе объекты:\n\n";

		for (int i = 0; i < size; i++) {

			arr[i]->show();

			cout << endl;
		}
	}

	//////////////////////////////////////////////////

	int getSize() {

		return size;
	}
};


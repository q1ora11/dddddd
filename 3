#include "stdafx.h"
#include <iostream>
using namespace std;
class Matrix {

protected:

	int rows;
	int cols;
	int** data;

public:

	Matrix(int r = 2, int c = 2) {

		rows = r;
		cols = c;

		data = new int*[rows];

		for (int i = 0; i < rows; i++) {

			data[i] = new int[cols];

			for (int j = 0; j < cols; j++) {
				data[i][j] = 0;
			}
		}
	}

	
	virtual ~Matrix() {

		for (int i = 0; i < rows; i++) {
			delete[] data[i];
		}

		delete[] data;
	}



	virtual void input() {

		cout << "Введите элементы:\n";

		for (int i = 0; i < rows; i++) {

			for (int j = 0; j < cols; j++) {
				cin >> data[i][j];
			}
		}
	}



	virtual void show() {

		for (int i = 0; i < rows; i++) {

			for (int j = 0; j < cols; j++) {
				cout << data[i][j] << " ";
			}

			cout << endl;
		}
	}
};



class SquareMatrix : public Matrix {

public:

	SquareMatrix(int n = 2)
		: Matrix(n, n) {
	}

	void show() override {

		cout << "Квадратная матрица:\n";

		Matrix::show();
	}
};



class DiagonalMatrix : public Matrix {

public:

	DiagonalMatrix(int n = 3)
		: Matrix(n, n) {
	}

	void input() override {

		cout << "Введите диагональ:\n";

		for (int i = 0; i < rows; i++) {

			for (int j = 0; j < cols; j++) {

				if (i == j) {
					cin >> data[i][j];
				}
				else {
					data[i][j] = 0;
				}
			}
		}
	}

	void show() override {

		cout << "Диагональная матрица:\n";

		Matrix::show();
	}
};



template<class T>

class MatrixSet {

private:

	T** arr;

	int size;

	int capacity;

public:


	MatrixSet(int cap = 10) {

		capacity = cap;

		size = 0;

		arr = new T*[capacity];
	}


	~MatrixSet() {

		delete[] arr;
	}



	void add(T* obj) {

		if (size < capacity) {

			arr[size] = obj;

			size++;
		}
	}



	void showAll() {

		cout << "\nВсе объекты:\n\n";

		for (int i = 0; i < size; i++) {

			arr[i]->show();

			cout << endl;
		}
	}

	

	int getSize() {

		return size;
	}
};



int main() {

	setlocale(LC_ALL, "Russian");

	SquareMatrix a(2);

	DiagonalMatrix b(3);

	a.input();

	b.input();



	MatrixSet<Matrix> ms;

	ms.add(&a);

	ms.add(&b);

	

	ms.showAll();

	

	cout << "Количество объектов: "
		<< ms.getSize()
		<< endl;

	system("pause");
}
